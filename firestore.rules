rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------
    // INITIAL SETUP / SEEDING RULE (Allows all reads and writes)
    // -------------------------------------------------------------
    // Use this rule in the Firebase Console (Rules tab) to allow
    // the seeder script or admin dashboard to insert your initial data.
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
